{
    "name": "suzumaze/bear-sunday-mcp-server",
    "description": "Read-only MCP adapter for BEAR.Sunday semantics exposed by Phpactor LSP",
    "keywords": [
        "bear-sunday",
        "language-server",
        "lsp",
        "mcp",
        "phpactor"
    ],
    "type": "project",
    "license": "MIT",
    "homepage": "https://github.com/suzumaze/bear-sunday-mcp-server",
    "support": {
        "issues": "https://github.com/suzumaze/bear-sunday-mcp-server/issues",
        "source": "https://github.com/suzumaze/bear-sunday-mcp-server"
    },
    "require": {
        "php": "^8.2",
        "mcp/sdk": "^0.8.1",
        "phpactor/language-server-protocol": "3.17.4",
        "phpactor/phpactor": "2026.07.22.0",
        "suzumaze/bear-phpactor-extension": "^0.1.9"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Suzumaze\\BearSundayMcp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Suzumaze\\BearSundayMcp\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/bear-sunday-mcp"
    ],
    "scripts": {
        "phpcs": "phpcs",
        "phpstan": "phpstan analyse --no-progress --memory-limit=256M",
        "phpunit": "phpunit",
        "check": [
            "@phpcs",
            "@phpstan",
            "@phpunit"
        ],
        "phpactor:init": "@php vendor/bin/bear-phpactor-init",
        "post-install-cmd": [
            "@phpactor:init"
        ],
        "post-update-cmd": [
            "@phpactor:init"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true
    }
}
