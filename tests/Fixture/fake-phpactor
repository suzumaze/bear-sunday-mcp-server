#!/usr/bin/env php
<?php

declare(strict_types=1);

/** @return array<string, mixed>|null */
function readMessage(): ?array
{
    $length = null;
    while (($line = fgets(STDIN)) !== false) {
        $line = rtrim($line, "\r\n");
        if ($line === '') {
            break;
        }
        if (preg_match('/^Content-Length:\s*(\d+)$/i', $line, $matches) === 1) {
            $length = (int) $matches[1];
        }
    }
    if ($length === null) {
        return null;
    }

    $body = '';
    while (strlen($body) < $length && !feof(STDIN)) {
        $chunk = fread(STDIN, $length - strlen($body));
        if ($chunk === false || $chunk === '') {
            return null;
        }
        $body .= $chunk;
    }

    $message = json_decode($body, true, 64, JSON_THROW_ON_ERROR);

    return is_array($message) ? $message : null;
}

/** @param array<string, mixed> $message */
function sendMessage(array $message): void
{
    $body = json_encode($message, JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES);
    fwrite(STDOUT, sprintf("Content-Length: %d\r\n\r\n%s", strlen($body), $body));
    fflush(STDOUT);
}

/** @param array<string, mixed> $data */
function success(array $data): array
{
    return [
        'status' => 'ok',
        'data' => $data,
        'candidates' => [],
        'provenance' => [],
    ];
}

/** @return array<string, array{line:int, character:int}> */
function lspRange(int $line, int $start, int $end): array
{
    return [
        'start' => ['line' => $line, 'character' => $start],
        'end' => ['line' => $line, 'character' => $end],
    ];
}

function fileUri(string $path): string
{
    $normalized = str_replace('\\', '/', $path);
    $encoded = implode('/', array_map('rawurlencode', explode('/', $normalized)));

    return 'file://' . (str_starts_with($encoded, '/') ? '' : '/') . $encoded;
}

$workingDirectory = null;
$autoConfigEnabled = true;
foreach (array_slice($argv, 1) as $argument) {
    if (str_starts_with($argument, '--working-dir=')) {
        $workingDirectory = substr($argument, strlen('--working-dir='));
        continue;
    }
    if (!str_starts_with($argument, '--config-extra=')) {
        continue;
    }

    $config = json_decode(substr($argument, strlen('--config-extra=')), true);
    if (is_array($config) && ($config['language_server_configuration.auto_config'] ?? null) === false) {
        $autoConfigEnabled = false;
    }
}

if (
    $autoConfigEnabled
    && is_string($workingDirectory)
    && is_file($workingDirectory . '/.simulate-phpactor-auto-config')
) {
    file_put_contents($workingDirectory . '/.phpactor.json', "{}\n");
}

while (($message = readMessage()) !== null) {
    $method = $message['method'] ?? null;
    if ($method === 'exit') {
        break;
    }
    if (!array_key_exists('id', $message)) {
        continue;
    }

    $userUri = fileUri(__DIR__ . '/workspace/src/Resource/App/User.php');
    $dashboardUri = fileUri(__DIR__ . '/workspace/src/Resource/App/Dashboard.php');
    $userSchemaUri = fileUri(__DIR__ . '/workspace/var/json_schema/user.json');
    $result = match ($method) {
        'initialize' => ['capabilities' => []],
        'shutdown' => null,
        'bear/project/info' => success([
            'semanticApiVersion' => 1,
            'workspaceName' => 'workspace',
            'projectPath' => '.',
            'composerPath' => 'composer.json',
            'psr4Roots' => ['src'],
            'excludedPsr4Roots' => [],
            'resourceCount' => 1,
            'capabilities' => [],
            'versions' => [],
            'compatibilityIssues' => [],
        ]),
        'bear/resource/list',
        'bear/resource/describe',
        'bear/resource/attributes',
        'bear/resource/attributeIndex',
        'bear/contract/compare',
        'bear/schema/describeForResource',
        'bear/route/resolve',
        'bear/sql/resolve',
        'bear/template/resolve',
        'bear/template/forResource',
        'bear/alps/describeDescriptor',
        'bear/resource/references',
        'bear/resource/incomingRelations' => success([
            'method' => $method,
            'params' => $message['params'] ?? [],
        ]),
        'textDocument/definition' => [
            'uri' => $userUri,
            'range' => lspRange(8, 12, 16),
        ],
        'textDocument/typeDefinition' => [
            'uri' => $userSchemaUri,
            'range' => lspRange(2, 2, 2),
        ],
        'textDocument/references' => [
            ['uri' => $dashboardUri, 'range' => lspRange(12, 31, 51)],
            ['uri' => $dashboardUri, 'range' => lspRange(13, 31, 46)],
        ],
        'textDocument/hover' => [
            'contents' => [
                'kind' => 'markdown',
                'value' => '**BEAR Resource** `app://self/user`',
            ],
            'range' => lspRange(12, 31, 51),
        ],
        'textDocument/completion' => [
            'isIncomplete' => true,
            'items' => [[
                'label' => 'app://self/user',
                'kind' => 12,
                'sortText' => '0001-user',
                'insertText' => 'user',
                'insertTextFormat' => 1,
            ]],
        ],
        'textDocument/documentSymbol' => [[
            'name' => 'Dashboard',
            'kind' => 5,
            'range' => lspRange(10, 0, 17),
            'selectionRange' => lspRange(10, 12, 21),
            'children' => [[
                'name' => 'onGet',
                'kind' => 6,
                'range' => lspRange(14, 4, 16),
                'selectionRange' => lspRange(14, 20, 25),
                'children' => [],
            ]],
        ]],
        'textDocument/documentLink' => [
            [
                'range' => lspRange(12, 31, 51),
                'target' => $userUri,
            ],
            [
                'range' => lspRange(13, 31, 46),
                'target' => $userUri,
            ],
        ],
        'workspace/symbol' => [[
            'name' => 'Acme\\Demo\\Resource\\App\\Dashboard',
            'kind' => 5,
            'location' => [
                'uri' => $dashboardUri,
                'range' => lspRange(10, 12, 21),
            ],
        ]],
        default => null,
    };

    sendMessage(['jsonrpc' => '2.0', 'id' => $message['id'], 'result' => $result]);
}
